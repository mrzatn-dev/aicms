# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cms_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_BUCKET_IMAGES=cms-images

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# JWT — required for all services; copy to .env and set a strong value for production
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# App
APP_NAME=CMS Microservice
APP_VERSION=1.0.0
DEBUG=true

# CORS - Allowed origins (comma-separated)
# For development: http://localhost:3000,http://localhost:8000
# For production: https://your-domain.com,https://your-api-domain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true

# OAuth — register callback URLs in provider consoles:
#   Google: {OAUTH_API_BASE_URL}/api/auth/callback/google
#   GitHub: {OAUTH_API_BASE_URL}/api/auth/callback/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:3000/oauth/callback
OAUTH_API_BASE_URL=http://localhost:3000

# Email verification (optional; off by default)
EMAIL_VERIFICATION_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=AI CMS <noreply@example.com>

# Frontend (docker build / Render) — same host as API in production:
# NEXT_PUBLIC_API_URL=https://your-app.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000
# Proxy /api/* to api-gateway when frontend and API are separate Render services:
# API_PROXY_TARGET=https://your-api-gateway.onrender.com

# Internal service auth (gateway → microservices)
INTERNAL_SERVICE_TOKEN=change-me-internal-token

# One-time admin bootstrap via POST /api/auth/bootstrap-admin (header X-Admin-Bootstrap-Secret)
ADMIN_BOOTSTRAP_SECRET=change-me-bootstrap-secret

# AI
DEEPSEEK_API_KEY=
