# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cms_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# JWT
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# App
APP_NAME=CMS Microservice
APP_VERSION=1.0.0
DEBUG=true

# OAuth — register these callback URLs in Google/GitHub consoles:
#   {OAUTH_API_BASE_URL}/api/auth/callback/google
#   {OAUTH_API_BASE_URL}/api/auth/callback/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:3000/oauth/callback
OAUTH_API_BASE_URL=http://localhost:8000

# Frontend (docker build / Render)
NEXT_PUBLIC_API_URL=http://localhost:8000

# AI
DEEPSEEK_API_KEY=
